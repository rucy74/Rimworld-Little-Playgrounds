<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ride sounds (Sounds/LittlePlaygrounds, sources and licences in Licenses/SoundCredits.txt). PlaygroundSounds plays them on the
       motion events of each ride. MapOnly = game sound volume. distRange = camera distance in cells: full volume closer than the
       first number, silent beyond the second (vanilla camera height runs 15 to 65), so they are heard only when zoomed in.
       volumeRange evens out the recordings' loudness (loudest 50 ms brought to about the same level). -->
  <SoundDef>
    <defName>LP_SandDig</defName>
    <context>MapOnly</context>
    <maxVoices>3</maxVoices>
    <maxSimultaneous>1</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>LittlePlaygrounds/LP_SandDig_01</clipPath></li></grains>
        <volumeRange>15~19</volumeRange>
        <pitchRange>0.94~1.06</pitchRange>
        <distRange>10~28</distRange>
        <muteWhenPaused>True</muteWhenPaused>
        <sustainLoop>False</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>
