<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>LP_Slide</defName>
    <label>playground slide</label>
    <description>A playground slide with steps on the left and a smooth chute on the right. Children and adults climb up, sit at the top and slide down. Children gain learning; adults gain recreation. Keep both ends clear.</description>
    <thingClass>LittlePlaygrounds.Building_Slide</thingClass>
    <graphicData>
      <texPath>Things/Building/SlidePolishV2</texPath>
      <graphicClass>LittlePlaygrounds.Graphic_PlaygroundPalette</graphicClass>
      <drawSize>(4.194,4.86)</drawSize>
      <drawOffset>(0.009,0,1.314)</drawOffset>
    </graphicData>
    <size>(5,5)</size>
    <rotatable>true</rotatable>
    <drawerType>RealtimeOnly</drawerType>
    <passability>Standable</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.2</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <designationCategory>Joy</designationCategory>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints><WorkToBuild>2200</WorkToBuild>
      <Mass>40</Mass><Flammability>0.25</Flammability><Beauty>6</Beauty>
    </statBases>
    <costList><Steel>60</Steel><WoodLog>20</WoodLog></costList>
    <comps><li Class="LittlePlaygrounds.CompProperties_PlaygroundPalette"/><li Class="LittlePlaygrounds.CompProperties_PlaygroundAccess"/><li Class="LittlePlaygrounds.CompProperties_PlaygroundDesign"/></comps><terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building><isEdifice>false</isEdifice><joyKind>Gaming_Dexterity</joyKind></building>
    <modExtensions><li Class="LittlePlaygrounds.TurnProperties"><kind>Distinct</kind></li></modExtensions>
  </ThingDef>
  <JobDef>
    <defName>LP_RideSlide</defName>
    <driverClass>LittlePlaygrounds.JobDriver_RideSlide</driverClass>
    <reportString>playing on the slide.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <joyKind>Gaming_Dexterity</joyKind><joyGainRate>1</joyGainRate><joyMaxParticipants>1</joyMaxParticipants>
  </JobDef>
  <AnimationDef>
    <defName>LP_SlidePose</defName><durationTicks>10000</durationTicks><loopMode>Loop</loopMode>
    <keyframeParts><li><key>Root</key><value>
      <workerType>LittlePlaygrounds.SlideAnimationWorker</workerType>
      <keyframes><li><tick>0</tick><angle>0</angle></li></keyframes>
    </value></li></keyframeParts>
  </AnimationDef>
</Defs>
