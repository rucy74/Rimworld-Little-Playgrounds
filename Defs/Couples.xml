<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A couple's time together on a ride or bench (PlaygroundCouples). One of each per partner at a time. -->
  <ThoughtDef>
    <defName>LP_PlaygroundDate</defName>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages><li><label>playground date</label><description>We had a lovely time together at the playground.</description><baseMoodEffect>4</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>LP_PlaygroundDateOpinion</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>10</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages><li><label>playground date</label><baseOpinionOffset>6</baseOpinionOffset></li></stages>
  </ThoughtDef>
</Defs>
