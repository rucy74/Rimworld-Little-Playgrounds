<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="LP_GardenBuilding" Abstract="True" ParentName="BuildingBase">
    <rotatable>false</rotatable><drawerType>RealtimeOnly</drawerType>
    <passability>Standable</passability><pathCost>20</pathCost><fillPercent>0.1</fillPercent>
    <altitudeLayer>Building</altitudeLayer><designationCategory>Joy</designationCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <statBases><MaxHitPoints>140</MaxHitPoints><WorkToBuild>1500</WorkToBuild><Mass>20</Mass><Flammability>0.5</Flammability><Beauty>5</Beauty></statBases>
    <building><isEdifice>false</isEdifice></building>
  </ThingDef>
  <ThingDef ParentName="LP_GardenBuilding">
    <comps><li Class="LittlePlaygrounds.CompProperties_PlaygroundAccess"/></comps>
    <defName>LP_Sandbox</defName><label>oak sandbox</label>
    <description>A pale oak sandbox with ivory corner seats. Up to three children or adults shape a mound into a tower and then a sandcastle, alone or together. Children gain learning; adults gain recreation. Their creation stays after they leave and slowly wears away when unused.</description>
    <thingClass>LittlePlaygrounds.Building_Sandbox</thingClass><building><joyKind>Gaming_Dexterity</joyKind></building><tickerType>Rare</tickerType>
    <size>(5,5)</size>
    <graphicData><texPath>Things/Building/OakSandpitPolishV2</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(4.5144,4.5144)</drawSize></graphicData>
    <costList><WoodLog>55</WoodLog><Steel>10</Steel></costList>
  </ThingDef>
  <ThingDef ParentName="LP_GardenBuilding">
    <comps><li Class="LittlePlaygrounds.CompProperties_PlaygroundAccess"/></comps>
    <defName>LP_GardenBench</defName><rotatable>true</rotatable><label>garden bench</label>
    <description>A rounded oak-and-ivory bench with room for two people. Colonists can choose it for recreation or be ordered to relax here. Place a shade canopy one cell behind the bench to shelter it.</description>
    <thingClass>LittlePlaygrounds.Building_GardenBench</thingClass><size>(3,1)</size>
    <graphicData><texPath>Things/Building/GardenBenchCompactV3</texPath><graphicClass>LittlePlaygrounds.Graphic_PlaygroundTurn</graphicClass><drawSize>(3.838,1.4782)</drawSize><drawOffset>(0,0,0.0399)</drawOffset></graphicData>
    <statBases><Comfort>0.8</Comfort></statBases>
    <building><joyKind>Meditative</joyKind></building>
    <costList><WoodLog>35</WoodLog><Steel>10</Steel></costList>
    <modExtensions><li Class="LittlePlaygrounds.TurnProperties"><kind>Distinct</kind></li></modExtensions>
  </ThingDef>
  <ThingDef ParentName="LP_GardenBuilding">
    <defName>LP_ShadeCanopy</defName><label>playground shade canopy</label><designationCategory>Furniture</designationCategory>
    <description>A cream fabric canopy on sage posts. Place its center marker one cell behind a bench. It shelters a five-by-three area in front without replacing existing roofs. The fabric stays opaque over seated visitors and fades when its raised image obscures a pawn.</description>
    <thingClass>LittlePlaygrounds.Building_ShadeCanopy</thingClass><size>(1,1)</size><uiIconScale>0.27</uiIconScale>
    <graphicData><texPath>Things/Building/ShadeCanopy</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(5.8368,3.8912)</drawSize><drawOffset>(0,0,0.0944)</drawOffset></graphicData>
    <costList><Steel>35</Steel><Cloth>40</Cloth></costList>
  </ThingDef>
  <RoofDef><defName>LP_FabricShade</defName><label>fabric canopy</label><isNatural>false</isNatural><isThickRoof>false</isThickRoof><canCollapse>false</canCollapse></RoofDef>
  <ThingDef Name="LP_CurbBase" ParentName="LP_GardenBuilding" Abstract="True">
    <thingClass>LittlePlaygrounds.Building_GardenCurb</thingClass><size>(1,1)</size><designationCategory>Structure</designationCategory><drawStyleCategory>Defenses</drawStyleCategory>
    <pathCost>5</pathCost><fillPercent>0</fillPercent>
    <graphicData><texPath>Things/Building/GardenCurb</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.2,0.4)</drawSize></graphicData>
    <statBases><MaxHitPoints>100</MaxHitPoints><WorkToBuild>80</WorkToBuild><Mass>2</Mass><Beauty>1</Beauty></statBases>
  </ThingDef>
  <ThingDef ParentName="LP_CurbBase"><defName>LP_OakCurb</defName><label>oak playground edging</label>
    <description>Low rounded oak edging. Adjacent playground edging connects automatically, including around corners. Pawns can step over it.</description>
    <costList><WoodLog>2</WoodLog></costList>
  </ThingDef>
  <ThingDef ParentName="LP_CurbBase"><defName>LP_IvoryCurb</defName><label>playground edging</label>
    <description>Low ivory edging for a finished playground boundary. Adjacent playground edging connects automatically, including around corners. Pawns can step over it. Built from any stone blocks; its shape and colors stay the same whichever stone you use.</description>
    <stuffCategories><li>Stony</li></stuffCategories><costStuffCount>2</costStuffCount>
  </ThingDef>
  <JobDef><defName>LP_PlayInSand</defName><driverClass>LittlePlaygrounds.JobDriver_GardenVisit</driverClass>
    <reportString>building sandcastles.</reportString><casualInterruptible>true</casualInterruptible>
    <joyKind>Gaming_Dexterity</joyKind><joyGainRate>1</joyGainRate><joyMaxParticipants>3</joyMaxParticipants>
  </JobDef>
  <JobDef><defName>LP_RelaxOnBench</defName><driverClass>LittlePlaygrounds.JobDriver_GardenVisit</driverClass>
    <reportString>relaxing on the garden bench.</reportString><casualInterruptible>true</casualInterruptible>
    <joyKind>Meditative</joyKind><joyDuration>1080</joyDuration><joyGainRate>1</joyGainRate><joyMaxParticipants>2</joyMaxParticipants>
  </JobDef>
  <JoyGiverDef><defName>LP_RelaxOnGardenBench</defName><giverClass>LittlePlaygrounds.JoyGiver_RelaxOnGardenBench</giverClass>
    <baseChance>2</baseChance><thingDefs><li>LP_GardenBench</li></thingDefs><jobDef>LP_RelaxOnBench</jobDef><joyKind>Meditative</joyKind>
    <requiredCapacities><li>Moving</li></requiredCapacities>
  </JoyGiverDef>
  <AnimationDef><defName>LP_GardenPose</defName><durationTicks>10000</durationTicks><loopMode>Loop</loopMode>
    <keyframeParts><li><key>Root</key><value><workerType>LittlePlaygrounds.GardenAnimationWorker</workerType>
      <keyframes><li><tick>0</tick><angle>0</angle></li></keyframes>
    </value></li></keyframeParts>
  </AnimationDef>
</Defs>
